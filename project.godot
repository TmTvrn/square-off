[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="one_way"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="hazard"
2d_physics/layer_6="player_attack"
2d_physics/layer_7="enemy_attack"
2d_physics/layer_8="enemy_only_floor"

[physics]

common/physics_interpolation=true

[rendering]

viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.039, 0.051, 0.075, 1)
